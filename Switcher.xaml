<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowTitleText}" Width="844" Height="474"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Foreground="#F2F5F9"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="SettingsScrollTrackButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingsScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="11"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SettingsScrollTrackButton}" Command="{x:Static ScrollBar.PageUpCommand}"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Width="7" HorizontalAlignment="Center" Background="#383A40" CornerRadius="3.5"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SettingsScrollTrackButton}" Command="{x:Static ScrollBar.PageDownCommand}"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingsDropdown" TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F2F5F9"/>
      <Setter Property="Background" Value="#303239"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MaxDropDownHeight" Value="160"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F5F9"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Row" CornerRadius="2" Background="Transparent">
                    <Grid MinHeight="30">
                      <Border x:Name="SelectionMark" HorizontalAlignment="Left" Width="2" Background="#1A86EB" Visibility="Collapsed"/>
                      <ContentPresenter Margin="10,4" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#303239"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="#262830"/>
                      <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                            Data="M 0,0 L 4,4 L 8,0" Stroke="#C6CFDC" StrokeThickness="1.3"/>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="12,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"/>
              <Border x:Name="DropdownFocus" BorderBrush="#4E4F54" BorderThickness="1" CornerRadius="3" IsHitTestVisible="False" Visibility="Collapsed"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}" VerticalOffset="2">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="#1A1C23" BorderBrush="#303239" BorderThickness="1" CornerRadius="3" Padding="6">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropdownFocus" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingsCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#F2F5F9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="3" Background="#151923" BorderBrush="#4E4F54" BorderThickness="1" VerticalAlignment="Center">
                <Path x:Name="Tick" Data="M 3,8 L 6,11 L 12,5" Stroke="White" StrokeThickness="1.6" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#006FD0"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#82C7FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Duration x:Key="FeedbackDuration">0:0:0.15</Duration>
    <Style x:Key="CardHighlight" TargetType="Border">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource FeedbackDuration}"/></Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <BeginStoryboard>
              <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource FeedbackDuration}"/></Storyboard>
            </BeginStoryboard>
          </DataTrigger.ExitActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <SolidColorBrush x:Key="SecondarySurface" Color="#23242B"/>
    <SolidColorBrush x:Key="ButtonSurface" Color="#313339"/>
    <SolidColorBrush x:Key="HoverSurface" Color="#313239"/>
    <SolidColorBrush x:Key="ButtonOutline" Color="#4E4F54"/>
    <Style x:Key="ButtonKeyboardFocus" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Control">
            <Border CornerRadius="4" BorderThickness="2" BorderBrush="{StaticResource ButtonOutline}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ButtonBase" TargetType="Button">
      <Setter Property="Foreground" Value="#F4F7FC"/>
      <Setter Property="Background" Value="{StaticResource ButtonSurface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ButtonOutline}"/>
      <Setter Property="Tag" Value="{StaticResource HoverSurface}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocus}"/>
      <Setter Property="Padding" Value="15,0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}">
              <Grid>
                <Border x:Name="HoverFill" CornerRadius="4" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                        Opacity="0" IsHitTestVisible="False"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                <Border x:Name="HoverOutline" CornerRadius="4" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}"
                        Opacity="0" IsHitTestVisible="False"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverOutline" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource FeedbackDuration}"/>
                      <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource FeedbackDuration}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverOutline" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource FeedbackDuration}"/>
                      <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource FeedbackDuration}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="#006FD0"/>
      <Setter Property="BorderBrush" Value="#1A86EB"/>
      <Setter Property="Tag" Value="{x:Null}"/>
      <Setter Property="Height" Value="43"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Tag" Value="{x:Null}"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="#AEB6C3"/>
    </Style>
  </Window.Resources>
  <Border CornerRadius="7">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#141921" Offset="0"/>
        <GradientStop Color="#14171E" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="82"/>
      </Grid.RowDefinitions>

      <Grid x:Name="TitleBar" Background="Transparent" Margin="17,0,9,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
          <Border Width="29" Height="29" Background="#1C3146" CornerRadius="15">
            <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Ellipse Canvas.Left="9.5" Canvas.Top="5.5" Width="7" Height="7" Stroke="#82C7FF" StrokeThickness="1.5"/>
              <Path Data="M 6.5,20 V 18.7 C 6.5,16.5 8.6,15 10.8,15 H 15.2 C 17.4,15 19.5,16.5 19.5,18.7 V 20" Stroke="#82C7FF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
          </Border>
          <TextBlock Text="battle.net account switcher" FontSize="17" FontWeight="Bold" Margin="10,0,17,0" VerticalAlignment="Center"/>
          <Border Width="1" Height="19" Background="#3B404B"/>
          <TextBlock Text="{DynamicResource HeaderText}" Foreground="#A0A8B6" FontWeight="Bold" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="UpdateNotice" Style="{StaticResource ButtonBase}" Height="28" FontSize="12" Margin="0,0,8,0"
                  ToolTip="{DynamicResource OpenReleaseText}" Visibility="Collapsed"/>
          <Button x:Name="SettingsButton" Style="{StaticResource CaptionButton}" ToolTip="{DynamicResource SettingsText}" AutomationProperties.Name="{DynamicResource SettingsText}">
            <Viewbox Width="17" Height="17">
              <Canvas Width="24" Height="24">
                <Path Stroke="#AEB6C3" StrokeThickness="1.6" StrokeLineJoin="Round">
                  <Path.Data>
                    <GeometryGroup>
                      <PathGeometry Figures="M 10,2 H 14 L 14.6,5 L 16.7,6.2 L 19.8,5.2 L 21.8,8.7 L 19.4,11 V 13 L 21.8,15.3 L 19.8,18.8 L 16.7,17.8 L 14.6,19 L 14,22 H 10 L 9.4,19 L 7.3,17.8 L 4.2,18.8 L 2.2,15.3 L 4.6,13 V 11 L 2.2,8.7 L 4.2,5.2 L 7.3,6.2 L 9.4,5 Z"/>
                      <EllipseGeometry Center="12,12" RadiusX="3.3" RadiusY="3.3"/>
                    </GeometryGroup>
                  </Path.Data>
                </Path>
              </Canvas>
            </Viewbox>
          </Button>
          <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" ToolTip="{DynamicResource MinimizeText}" AutomationProperties.Name="{DynamicResource MinimizeText}"><Path Data="M 0,4 L 10,4" Stroke="#AEB6C3" StrokeThickness="1"/></Button>
          <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" ToolTip="{DynamicResource CloseText}" AutomationProperties.Name="{DynamicResource CloseText}"><Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="#AEB6C3" StrokeThickness="1"/></Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="26,0,26,18">
        <Grid.RowDefinitions><RowDefinition Height="63"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="ListTitle" FontSize="12" FontWeight="Bold" Foreground="#B8C1CF" VerticalAlignment="Center"/>
            <Border Background="{StaticResource SecondarySurface}" CornerRadius="3" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="AccountCount" FontSize="11" Foreground="#D0DAE7"/></Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="HiddenListButton" Style="{StaticResource ButtonBase}" Height="28" FontSize="12" Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button x:Name="RefreshButton" Style="{StaticResource ButtonBase}" Height="28" FontSize="12" Content="{DynamicResource RefreshText}" ToolTip="{DynamicResource RefreshHintText}"/>
          </StackPanel>
        </Grid>

        <ListBox x:Name="Accounts" Grid.Row="1" BorderThickness="0" Padding="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.Template>
            <ControlTemplate TargetType="ListBox">
              <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </ControlTemplate>
          </ListBox.Template>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Width" Value="181"/>
              <Setter Property="Margin" Value="5,0,5,9"/>
              <Setter Property="Background" Value="#22242A"/>
              <Setter Property="Foreground" Value="#F4F6FA"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="ToolTip" Value="{Binding Login}"/>
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5" MinHeight="202">
                      <Grid>
                        <Border Style="{StaticResource CardHighlight}" Background="{StaticResource HoverSurface}" Tag="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Border Style="{StaticResource CardHighlight}" BorderBrush="#2869A7" BorderThickness="2"
                                Tag="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Border Style="{StaticResource CardHighlight}" Background="#313238" BorderBrush="#2869A7" BorderThickness="2"
                                Tag="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter VerticalAlignment="Top" Margin="10,17,10,14"/>
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <Border Width="76" Height="76" HorizontalAlignment="Center" Background="{Binding Avatar}" CornerRadius="38">
                  <TextBlock Text="{Binding Initials}" FontSize="25" FontWeight="Bold" Foreground="#F2F7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Name}" TextAlignment="Center" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding Login}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#C5D0DF" FontSize="12" Margin="0,4,0,0"/>
                <Border Background="#273D4F" CornerRadius="3" Padding="7,4" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="{Binding Recent}">
                  <TextBlock Text="{DynamicResource RecentText}" FontWeight="SemiBold" FontSize="10" Foreground="#A6D5FC"/>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="EmptyPanel" Grid.Row="1" Background="#21242D" CornerRadius="5" Visibility="Collapsed">
          <StackPanel Margin="18" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock x:Name="EmptyHint" Foreground="#B5C0CD" Margin="0,5,0,13" TextWrapping="Wrap"/>
            <Button x:Name="OpenClientButton" Style="{StaticResource ButtonBase}" Content="{DynamicResource OpenClientText}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="#1B1E26" CornerRadius="0,0,6,6">
        <Grid Margin="26,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#D7E0ED" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock x:Name="StatusHint" TextWrapping="Wrap" Foreground="#A1ACBC" FontSize="11" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="HideButton" Style="{StaticResource ButtonBase}" Width="43" Height="43" Padding="0" Margin="0,0,9,0"
                    ToolTip="{DynamicResource HideText}" AutomationProperties.Name="{DynamicResource HideText}">
              <Viewbox Width="20" Height="20">
                <Canvas Width="24" Height="24">
                  <Path Data="M 3,3 L 21,21 M 10.5,6.1 C 15.8,5.2 19.8,8.8 22,12 C 21.1,13.3 20.1,14.4 18.8,15.4 M 6.5,7.7 C 4.7,8.8 3.2,10.4 2,12 C 4.1,14.8 7.4,18 12,18 C 13.5,18 14.9,17.7 16.2,17.2 M 9.5,10.5 C 8,13.3 10.7,16 13.5,14.5"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Canvas>
              </Viewbox>
            </Button>
            <Button x:Name="RestoreButton" Style="{StaticResource ButtonBase}" Height="43" Content="{DynamicResource RestoreText}" Visibility="Collapsed"/>
            <Button x:Name="RenameButton" Style="{StaticResource ButtonBase}" Width="43" Height="43" Padding="0" Margin="0,0,9,0"
                    ToolTip="{DynamicResource RenameText}" AutomationProperties.Name="{DynamicResource RenameText}">
              <Viewbox Width="20" Height="20">
                <Canvas Width="24" Height="24">
                  <Path Data="M 4,16 L 15.8,4.2 Q 17.1,2.9 18.4,4.2 L 19.8,5.6 Q 21.1,6.9 19.8,8.2 L 8,20 L 3,21 Z M 14,6 L 18,10"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Canvas>
              </Viewbox>
            </Button>
            <Button x:Name="LaunchButton" Style="{StaticResource Primary}" Content="{DynamicResource OpenClientText}"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid x:Name="RenamePanel" Grid.RowSpan="3" Background="#CA0A0D13" Visibility="Collapsed" FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle">
        <Border Background="#222630" CornerRadius="6" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="23">
          <StackPanel>
            <TextBlock Text="{DynamicResource ProfileNameText}" FontWeight="Bold" FontSize="22"/>
            <TextBlock x:Name="RenameHint" Foreground="#B7C5D5" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,12"/>
            <TextBox x:Name="ProfileName" MaxLength="32" AutomationProperties.Name="{DynamicResource ProfileNameText}" Padding="8,7" Background="#151923" Foreground="#F2F5F9" CaretBrush="White" BorderThickness="0"/>
            <TextBlock Text="{DynamicResource RenameHintText}" Foreground="#B3BECC" FontSize="11" Margin="0,6,0,14" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="CancelRename" Style="{StaticResource ButtonBase}" Height="38" Content="{DynamicResource CancelText}" Margin="0,0,8,0"/>
              <Button x:Name="SaveRename" Style="{StaticResource Primary}" Height="38" Content="{DynamicResource SaveText}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Border x:Name="SettingsPanel" Grid.RowSpan="3" Background="#CA0A0D13" CornerRadius="7"
              Visibility="Collapsed" FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle">
        <Grid x:Name="SettingsViewport" Margin="16">
          <Border Background="#15171E" BorderBrush="#24262D" BorderThickness="1" CornerRadius="6" Width="540"
                  MaxWidth="{Binding ActualWidth, ElementName=SettingsViewport}" MaxHeight="{Binding ActualHeight, ElementName=SettingsViewport}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20">
            <Border.Resources>
              <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBar}"/>
            </Border.Resources>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel LastChildFill="False" Margin="0,0,0,14">
                <TextBlock Text="{DynamicResource SettingsText}" FontWeight="Bold" FontSize="22"/>
                <TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" Foreground="#AEBBCA" FontSize="12" VerticalAlignment="Center"/>
              </DockPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,20,0">
                  <TextBlock Text="{DynamicResource GeneralText}" FontWeight="Bold" FontSize="15"/>
                  <StackPanel Margin="16,8,0,0">
                    <TextBlock Text="{DynamicResource LanguageText}" FontWeight="Bold" Foreground="#B8C1CF" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="LanguageSelect" Style="{StaticResource SettingsDropdown}"
                              SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource LanguageText}">
                      <ComboBoxItem Content="Русский" Tag="ru"/>
                      <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>
                  </StackPanel>
                  <TextBlock Text="{DynamicResource UpdatesText}" FontWeight="Bold" FontSize="15" Margin="0,16,0,0"/>
                  <StackPanel Margin="16,8,0,0">
                    <CheckBox x:Name="AutoUpdateCheck" Content="{DynamicResource AutoUpdateText}" Style="{StaticResource SettingsCheck}"/>
                    <TextBlock x:Name="UpdateStatus" Foreground="#B3BECC" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <WrapPanel Margin="0,8,0,0">
                      <Button x:Name="CheckUpdateButton" Style="{StaticResource ButtonBase}" Content="{DynamicResource CheckUpdatesText}" Margin="0,0,8,0"/>
                      <Button x:Name="ReleaseButton" Style="{StaticResource ButtonBase}" Content="{DynamicResource OpenReleaseText}" Visibility="Collapsed"/>
                    </WrapPanel>
                  </StackPanel>
                  <TextBlock Text="{DynamicResource AboutText}" FontWeight="Bold" FontSize="15" Margin="0,16,0,0"/>
                  <TextBlock Text="{DynamicResource LegalText}" Foreground="#B3BECC" FontSize="12" TextWrapping="Wrap" Margin="16,6,0,0"/>
                </StackPanel>
              </ScrollViewer>
              <Button Grid.Row="2" x:Name="SaveSettingsButton" Style="{StaticResource Primary}" Content="{DynamicResource DoneText}"
                      Height="36" MinWidth="96" HorizontalAlignment="Right" Margin="0,14,0,0"/>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
